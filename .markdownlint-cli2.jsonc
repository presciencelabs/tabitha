{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD033": false
  },
  "ignores": [
    "**/node_modules/**",
    "**/.svelte-kit/**",
    "**/.turbo/**",
    "**/.wrangler/**",
    // Generated output, gitignored like the entries above: `wrangler deploy --dry-run --outdir dist`
    // copies an app's README into dist/, and failed Playwright runs leave error-context.md files.
    "**/dist/**",
    "**/test-results/**",
    "tmp/**",
    // Vendored skill reference docs, not this repo's own authored content -- not worth
    // reformatting to our lint rules.
    ".claude/skills/**"
  ]
}
