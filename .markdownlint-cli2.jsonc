{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD033": false
  },
  "ignores": [
    "**/node_modules/**",
    "**/.svelte-kit/**",
    "**/.turbo/**",
    "**/.wrangler/**",
    "tmp/**",
    // Vendored skill reference docs, not this repo's own authored content -- not worth
    // reformatting to our lint rules.
    ".claude/skills/**"
  ]
}
