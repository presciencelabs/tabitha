{
  "name": "@tabitha/scripts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo-wide dev-experience and audit scripts",
  "exports": {
    "./*": "./*.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "check:lint": "eslint .",
    "check:lint:fix": "eslint . --fix",
    "test": "bun run test:unit",
    "test:unit": "bun test ."
  },
  "dependencies": {
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tabitha/ai": "workspace:*",
    "@tabitha/eslint-config": "workspace:*",
    "@tabitha/tsconfig": "workspace:*",
    "@tabitha/types": "workspace:*",
    "@tabitha/vite-config": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "turbo": "^2.11.2",
    "typescript": "^6.0.3"
  }
}
