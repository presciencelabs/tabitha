{
	"name": "@tabitha/www",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "svelte-kit sync",
		"check": "bun run prepare && bun run check:svelte",
		"check:svelte": "svelte-check --tsconfig ./tsconfig.json",
		"check:lint": "eslint .",
		"check:lint:fix": "eslint . --fix",
		"build": "vite build",
		"dev": "vite dev",
		"dev:e2e": "vite dev",
		"test": "bun run test:e2e",
		"test:e2e": "playwright test",
		"test:e2e:dev": "playwright test --ui",
		"precommit": "bun run check && bun run build && bun run test",
		"clean:svelte": "rm -rf .svelte-kit",
		"clean:deps": "rm -rf node_modules",
		"clean:powerwash": "(bun run clean:svelte & bun run clean:deps) && bun install"
	},
	"dependencies": {
		"@sveltejs/kit": "^2.70.2",
		"@tabitha/api-client": "workspace:*",
		"@tabitha/types": "workspace:*",
		"@tabitha/ui": "workspace:*",
		"@tailwindcss/typography": "^0.5.20",
		"daisyui": "^5.7.17",
		"svelte": "^5.56.9",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tabitha/eslint-config": "workspace:*",
		"@tabitha/vite-config": "workspace:*",
		"@tailwindcss/vite": "^4.3.3",
		"eslint": "^10.8.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "8.2.0",
		"wrangler": "^4.123.0"
	}
}
