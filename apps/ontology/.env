PUBLIC_SOURCES_API_HOST=https://sources.tabitha.bible
PUBLIC_TARGETS_API_HOST=https://targets.tabitha.bible

# Cloudflare AI Gateway routing -- shared with apps/copilot, see docs/decisions/0005-ai-consolidation.md.
# Not sensitive on their own (identifiers, not credentials).
CLOUDFLARE_ACCOUNT_ID=8582954a9e4c6f0259c6236be794d7d3
GEMINI_PROJECT_ID=gen-lang-client-0319586327
GEMINI_LOCATION=global

# secrets (always empty in this file -- set real values only in .env.local, which is gitignored)

# https://authjs.dev/reference/sveltekit#lazy-initialization
AUTH_SECRET=

# https://console.cloud.google.com/auth/clients
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# From the AI Gateway's own Settings -> Authenticated Gateway -> Create authentication token.
AI_GATEWAY_TOKEN=
