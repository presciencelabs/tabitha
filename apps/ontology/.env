# ══════════════════════════════════════════════════════════════════════════
# OPEN CONFIG
# Real values, safe to commit. May be public (client-exposed) or private
# (server-only) -- see the $env/... tag on each line for which SvelteKit
# module to import it from. Cloudflare: belongs in wrangler.jsonc's `vars`
# block for real deployments, not a `wrangler secret`.
# ══════════════════════════════════════════════════════════════════════════

# $env/static/public -- a sibling app's API host, safe for client code to call directly
PUBLIC_SOURCES_API_HOST=https://sources.tabitha.bible
PUBLIC_TARGETS_API_HOST=https://targets.tabitha.bible

# $env/static/public -- blank is the correct production value ("off") -- scripts/dx/setup_env.ts
# sets this to `true` only in .env.local, so local dev alone gets cross-origin access
PUBLIC_CORS_ALLOW_LOCALHOST=

# $env/static/private -- not secret, but the real value only applies to genuine Cloudflare
# deployments (prod & preview) -- scripts/dx/setup_env.ts forces this blank in .env.local
# so local dev never sends it to Auth.js
OAUTH_REDIRECT_PROXY_URL=https://ontology.tabitha.bible/auth

# $env/static/private -- not secret, also replicated in wrangler.jsonc's `vars` for real
# deployments -- https://console.cloud.google.com/auth/clients
GOOGLE_OAUTH_CLIENT_ID=920310198944-m3ndmqnajejoa1drvkubke6gvr888rv7.apps.googleusercontent.com

# ══════════════════════════════════════════════════════════════════════════
# SECRETS
# Left blank here; real values live only in .env.local (gitignored) or the
# deployment's own secret store. Still tagged with the SvelteKit module
# they're read through. Cloudflare: set via `wrangler secret put <NAME>`
# (or the dashboard), never in wrangler.jsonc `vars` --
# scripts/audits/check_cloudflare.ts enforces this.
# ══════════════════════════════════════════════════════════════════════════

# $env/static/private -- https://authjs.dev/reference/sveltekit#lazy-initialization
AUTH_SECRET=

# $env/static/private -- https://console.cloud.google.com/auth/clients
GOOGLE_OAUTH_CLIENT_SECRET=

# $env/dynamic/private -- https://aistudio.google.com/app/apikey
API_KEY_GEMINI=
