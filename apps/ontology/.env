PUBLIC_SOURCES_API_HOST=https://sources.tabitha.bible
PUBLIC_TARGETS_API_HOST=https://targets.tabitha.bible

# secrets (always empty in this file -- set real values only in .env.local, which is gitignored)
# https://authjs.dev/reference/sveltekit#lazy-initialization
AUTH_SECRET=

# https://console.cloud.google.com/auth/clients
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# https://aistudio.google.com/app/apikey
API_KEY_GEMINI=
