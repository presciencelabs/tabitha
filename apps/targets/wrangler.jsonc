{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "targets",
	"compatibility_date": "2026-08-30",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"routes": [
		{
			"pattern": "targets.tabitha.bible",
			"custom_domain": true
		}
	],
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "3",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	// One D1 database per target-language project (docs/decisions/0012-per-project-targets-databases.md).
	// Binding names must match TARGET_PROJECTS in @tabitha/types/target. database_name follows the
	// same "<Task>_<date>" convention as Sources/Ontology (each migration run mints a fresh dated
	// database rather than updating in place).
	"d1_databases": [
		{
			"binding": "DB_Targets_English",
			"database_name": "Targets_English_2026-07-31",
			"database_id": "fa05d7a0-3241-465f-b47a-80898f86c1a9"
		},
		{
			"binding": "DB_Targets_Swahili",
			"database_name": "Targets_Swahili_2026-07-31",
			"database_id": "ef94ce5e-a99c-40c2-ab55-402d17bf4326"
		},
		{
			"binding": "DB_Targets_Indonesian",
			"database_name": "Targets_Indonesian_2026-07-31",
			"database_id": "3925008c-d42f-49b5-8552-88a1902dbe2c"
		},
		{
			"binding": "DB_Targets_Tagalog",
			"database_name": "Targets_Tagalog_2026-07-31",
			"database_id": "8c9b556c-c434-48d3-a8bc-a2b48f336328"
		}
	],
	"placement": {
		// Necessary to support D1 withSession() bookmarking and edge proximity routing
		// https://developers.cloudflare.com/d1/concepts/sessions/
		"mode": "off"
	}
}
