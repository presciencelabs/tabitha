{
  "name": "tabitha-sources",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync",
    "check": "pnpm prepare && (pnpm check:svelte & pnpm check:lint)",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "check:lint": "eslint .",
    "check:lint:fix": "eslint . --fix",
    "build": "vite build",
    "dev": "vite dev",
    "test:unit": "vitest run src",
    "test:e2e": "playwright test",
    "test": "pnpm test:unit && pnpm test:e2e",
    "precommit": "pnpm check && pnpm build && pnpm test",
    "clean:svelte": "rimraf .svelte-kit",
    "clean:node": "rimraf node_modules",
    "clean:powerwash": "(pnpm clean:svelte & pnpm clean:node) && pnpm install"
  },
  "dependencies": {
    "@sveltejs/kit": "^2.70.2",
    "@tailwindcss/typography": "^0.5.20",
    "daisyui": "^5.7.16",
    "svelte": "^5.56.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "@eslint/compat": "^2.1.0",
    "@iconify/svelte": "^5.2.2",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tabitha/eslint-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.8.1",
    "postcss": "^8.5.26",
    "rimraf": "^6.1.3",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.3",
    "vite": "8.2.0",
    "vitest": "^3.0.7",
    "wrangler": "^4.120.1"
  }
}