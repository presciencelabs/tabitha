{
  "name": "@tabitha/copilot",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync",
    "check": "pnpm prepare && (pnpm check:svelte & pnpm check:lint)",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "check:lint": "eslint .",
    "check:lint:fix": "eslint . --fix",
    "build": "vite build",
    "dev": "vite dev",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run src --passWithNoTests",
    "test:unit:watch": "vitest watch",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --ui",
    "gen": "wrangler types",
    "precommit": "pnpm check && pnpm build && pnpm test",
    "clean:svelte": "rimraf .svelte-kit",
    "clean:node": "rimraf node_modules",
    "clean:powerwash": "(pnpm clean:svelte & pnpm clean:node) && pnpm install"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@sveltejs/kit": "^2.70.2",
    "@tabitha/api-client": "workspace:*",
    "@tabitha/types": "workspace:*",
    "@tabitha/ui": "workspace:*",
    "@tailwindcss/typography": "^0.5.20",
    "daisyui": "^5.7.17",
    "svelte": "^5.56.9",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@fontsource/fira-mono": "^5.3.0",
    "@iconify/svelte": "^5.2.2",
    "@neoconfetti/svelte": "^2.2.2",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tabitha/eslint-config": "workspace:*",
    "@tabitha/vite-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "rimraf": "^6.1.3",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "8.2.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.123.0"
  }
}