PUBLIC_SOURCES_API_HOST=https://sources.tabitha.bible
PUBLIC_TARGETS_API_HOST=https://targets.tabitha.bible

# Since these are public and part of the cloud deployment, they need to be replicated in the wrangler.jsonc `vars` section.
GEMINI_PROJECT_ID=
GEMINI_LOCATION=

# secrets (always empty in this file -- set real values only in .env.local, which is gitignored)
# https://www.aquifer.bible/apiaccess (requested by email, not self-serve)
API_KEY_AQUIFER=

# https://console.cloud.google.com/iam-admin/serviceaccounts
GEMINI_CLIENT_EMAIL=
GEMINI_PRIVATE_KEY=
