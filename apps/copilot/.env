# ══════════════════════════════════════════════════════════════════════════
# OPEN CONFIG
# Real values, safe to commit. May be public (client-exposed) or private
# (server-only) -- see the $env/... tag on each line for which SvelteKit
# module to import it from. Cloudflare: belongs in wrangler.jsonc's `vars`
# block for real deployments, not a `wrangler secret`.
# ══════════════════════════════════════════════════════════════════════════

# $env/static/public -- a sibling app's API host, safe for client code to call directly
PUBLIC_SOURCES_API_HOST=https://sources.tabitha.bible
PUBLIC_TARGETS_API_HOST=https://targets.tabitha.bible

# $env/dynamic/private -- not secret (identifiers, not credentials), also replicated in
# wrangler.jsonc's `vars` for real deployments -- Cloudflare AI Gateway routing, shared with
# apps/ontology, see docs/decisions/0007-ai-consolidation.md
CLOUDFLARE_ACCOUNT_ID=8582954a9e4c6f0259c6236be794d7d3
GEMINI_PROJECT_ID=gen-lang-client-0319586327
GEMINI_LOCATION=global

# ══════════════════════════════════════════════════════════════════════════
# SECRETS
# Left blank here; real values live only in .env.local (gitignored) or the
# deployment's own secret store. Still tagged with the SvelteKit module
# they're read through. Cloudflare: set via `wrangler secret put <NAME>`
# (or the dashboard), never in wrangler.jsonc `vars` --
# scripts/audits/check_cloudflare.ts enforces this.
# ══════════════════════════════════════════════════════════════════════════

# $env/dynamic/private -- https://www.aquifer.bible/apiaccess (requested by email, not self-serve)
API_KEY_AQUIFER=

# $env/dynamic/private -- from the AI Gateway's own Settings -> Authenticated Gateway -> Create
# authentication token
AI_GATEWAY_TOKEN=
