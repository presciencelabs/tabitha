PUBLIC_SOURCES_API_HOST=https://sources.tabitha.bible
PUBLIC_TARGETS_API_HOST=https://targets.tabitha.bible

# Cloudflare AI Gateway routing -- shared with apps/ontology, see docs/decisions/0005-ai-consolidation.md.
# Not sensitive on their own (identifiers, not credentials). Since these are public and part of the
# cloud deployment, they need to be replicated in the wrangler.jsonc `vars` section.
CLOUDFLARE_ACCOUNT_ID=8582954a9e4c6f0259c6236be794d7d3
GEMINI_PROJECT_ID=gen-lang-client-0319586327
GEMINI_LOCATION=global

# secrets (always empty in this file -- set real values only in .env.local, which is gitignored)

# https://www.aquifer.bible/apiaccess (requested by email, not self-serve)
API_KEY_AQUIFER=

# From the AI Gateway's own Settings -> Authenticated Gateway -> Create authentication token.
AI_GATEWAY_TOKEN=
