{
  "name": "tabitha-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:copilot": "pnpm --filter tabitha-copilot dev",
    "dev:editor": "pnpm --filter tabitha-editor dev",
    "dev:ontology": "pnpm --filter tabitha-ontology dev",
    "dev:sources": "pnpm --filter tabitha-sources dev",
    "dev:targets": "pnpm --filter tabitha-targets dev",
    "setup": "bun tools/databases/scripts/setup.ts",
    "setup:env": "bun tools/databases/scripts/setup_env.ts",
    "db:load": "bun tools/databases/scripts/load_d1.ts all",
    "db:load:ontology": "bun tools/databases/scripts/load_d1.ts ontology",
    "db:load:sources": "bun tools/databases/scripts/load_d1.ts sources",
    "db:load:targets": "bun tools/databases/scripts/load_d1.ts targets",
    "build": "turbo run build",
    "check": "turbo run check",
    "check:philosophies": "bun tools/databases/scripts/check_philosophies.ts",
    "check:secrets": "bun tools/databases/scripts/check_secrets.ts",
    "check:cloudflare": "bun tools/databases/scripts/check_cloudflare.ts",
    "check:md": "markdownlint-cli2 '**/*.md'",
    "check:svelte": "turbo run check:svelte",
    "check:lint": "turbo run check:lint",
    "check:lint:fix": "turbo run check:lint:fix",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "clean:svelte": "turbo run clean:svelte",
    "clean:node": "turbo run clean:node && rimraf node_modules",
    "clean:powerwash": "pnpm clean:svelte && pnpm clean:node && pnpm install",
    "update:safe": "bun tools/databases/scripts/update_safe.ts",
    "update:interactive": "pnpm update --interactive --latest -r"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.17.2",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.10"
  }
}
