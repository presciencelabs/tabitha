{
	"name": "tabitha-ontology",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "svelte-kit sync",
		"check": "pnpm prepare && (pnpm check:svelte & pnpm check:lint)",
		"check:svelte": "svelte-check --tsconfig ./tsconfig.json",
		"check:lint": "eslint .",
		"check:lint:fix": "eslint . --fix",
		"build": "vite build",
		"dev": "vite dev",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:dev": "playwright test --ui",
		"test": "pnpm test:unit && pnpm test:e2e",
		"precommit": "pnpm check && pnpm build && pnpm test",
		"clean:svelte": "rimraf .svelte-kit",
		"clean:node": "rimraf node_modules",
		"clean:powerwash": "(pnpm clean:svelte & pnpm clean:node) && pnpm install"
	},
	"dependencies": {
		"@auth/sveltekit": "^1.11.2",
		"@google/genai": "^2.10.0",
		"@sveltejs/kit": "^2.69.1",
		"@tailwindcss/typography": "^0.5.20",
		"daisyui": "^5.7.16",
		"svelte": "^5.56.4",
		"tailwindcss": "^4.3.2"
	},
	"devDependencies": {
		"@auth/core": "^0.41.2",
		"@cloudflare/workers-types": "^5.20260707.1",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@iconify/svelte": "^5.2.2",
		"@playwright/test": "^1.61.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "^26.1.0",
		"eslint": "^10.6.0",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"postcss": "^8.5.16",
		"rimraf": "^6.1.3",
		"svelte-check": "^4.7.2",
		"svelte-eslint-parser": "^1.8.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.63.0",
		"vite": "^8.1.3",
		"vitest": "^4.1.10",
		"wrangler": "^4.107.0"
	}
}
