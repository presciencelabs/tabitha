# ══════════════════════════════════════════════════════════════════════════
# OPEN CONFIG
# Real values, safe to commit. Loaded via Bun's native process.env (this is
# a tooling script, not a SvelteKit app, so there's no $env module here).
# ══════════════════════════════════════════════════════════════════════════

CLOUDFLARE_ACCOUNT_ID=8582954a9e4c6f0259c6236be794d7d3

# Same values as apps/copilot's / apps/ontology's GEMINI_PROJECT_ID / GEMINI_LOCATION -- not
# sensitive on their own (identifiers, not credentials). Only needed for verify_gateway.ts and
# verify_cache_metadata.ts.
GEMINI_PROJECT_ID=gen-lang-client-0319586327
GEMINI_LOCATION=global

# ══════════════════════════════════════════════════════════════════════════
# SECRETS
# Left blank here; real values live only in .env.local (gitignored).
# ══════════════════════════════════════════════════════════════════════════

# https://dash.cloudflare.com/profile/api-tokens
# Needs the "AI Gateway" Edit account permission (Cloudflare API tokens don't currently expose
# a narrower AI Gateway-only scope than that). Used to manage the gateway resource itself (apply.ts).
CLOUDFLARE_API_TOKEN=

# From the gateway's own Settings -> Authenticated Gateway -> Create authentication token. Distinct
# from CLOUDFLARE_API_TOKEN above -- this is the per-gateway request-time token (`cf-aig-authorization`)
# apps actually send when calling through the gateway. Only needed for verify_gateway.ts and
# verify_cache_metadata.ts.
AI_GATEWAY_TOKEN=
