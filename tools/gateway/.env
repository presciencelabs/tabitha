CLOUDFLARE_ACCOUNT_ID=8582954a9e4c6f0259c6236be794d7d3

# Same values as apps/copilot's GEMINI_PROJECT_ID / GEMINI_LOCATION -- not sensitive on their own
# (identifiers, not credentials), so unlike the secrets below these are fine to commit here
# directly. Only needed for verify_gateway.ts.
GEMINI_PROJECT_ID=
GEMINI_LOCATION=

# secrets (always empty in this file -- set real values only in .env.local, which is gitignored)

# https://dash.cloudflare.com/profile/api-tokens
# Needs the "AI Gateway" Edit account permission (Cloudflare API tokens don't currently expose
# a narrower AI Gateway-only scope than that). Used to manage the gateway resource itself (apply.ts).
CLOUDFLARE_API_TOKEN=

# From the gateway's own Settings -> Authenticated Gateway -> Create authentication token. Distinct
# from CLOUDFLARE_API_TOKEN above -- this is the per-gateway request-time token (`cf-aig-authorization`)
# apps actually send when calling through the gateway. Only needed for verify_gateway.ts.
AI_GATEWAY_TOKEN=
