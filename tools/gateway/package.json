{
  "name": "@tabitha/gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Provisions and reconciles the shared Cloudflare AI Gateway all TaBiThA apps route AI calls through",
  "scripts": {
    "check": "tsc --noEmit",
    "check:lint": "eslint .",
    "check:lint:fix": "eslint . --fix",
    "test": "bun run test:unit",
    "test:unit": "bun test",
    "apply": "bun apply.ts",
    "verify": "bun verify_gateway.ts",
    "verify:cache": "bun verify_cache_metadata.ts"
  },
  "devDependencies": {
    "@google/genai": "^2.23.0",
    "@tabitha/ai": "workspace:*",
    "@tabitha/eslint-config": "workspace:*",
    "@tabitha/tsconfig": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3"
  }
}
