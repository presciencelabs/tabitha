# ══════════════════════════════════════════════════════════════════════════
# OPEN CONFIG
# Real values, safe to commit. Loaded via Bun's native process.env (this is
# a tooling script, not a SvelteKit app, so there's no $env module here).
# ══════════════════════════════════════════════════════════════════════════

# tabitha.bible's Cloudflare zone id -- not sensitive on its own (an identifier, not a credential).
CLOUDFLARE_ZONE_ID=be132ce1c4b86f60623d1cd0d0f38a58

# ══════════════════════════════════════════════════════════════════════════
# SECRETS
# Left blank here; real values live only in .env.local (gitignored).
# ══════════════════════════════════════════════════════════════════════════

# https://dash.cloudflare.com/profile/api-tokens -- create a token scoped to this zone only
# (Zone Resources: tabitha.bible), with permissions Zone > DNS > Edit and Zone > Dynamic Redirect >
# Edit. Used by apply.ts to reconcile config.ts against the live zone.
CLOUDFLARE_API_TOKEN=
